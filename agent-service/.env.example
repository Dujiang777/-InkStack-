# 复制为 .env 并填写
# DeepSeek（必填，分身/写作的真实生成能力）
DEEPSEEK_API_KEY=
# DeepSeek 走 OpenAI 兼容接口
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# MySQL（分身检索工具用；与 Next.js 的 DATABASE_URL 同库）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=inkstack

# 服务端口
AGENT_SERVICE_PORT=8100
