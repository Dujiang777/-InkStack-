# 依赖与构建产物
node_modules/
# 双轨验证的第二个 dev 实例各自要独立构建目录（NEXT_DIST_DIR），名字随场景变，一律不入库
.next/
.next-*/
.next.bak.*/
out/
tsconfig.tsbuildinfo

# 环境变量与密钥（任何目录层级）
.env
.env.local
.env.*.local

# Python 虚拟环境（agent-service）
.venv/
venv/

# 日志
*.log

# 上传目录（必须锚到 /public/：不带斜杠的 uploads/ 会匹配任何层级的同名目录，
# 当年 app/api/uploads/route.ts 就是这么被吞掉的——一个从没被跟踪过的源码文件，
# git status / git rm 都不会提它，删 app/api 时它静静留在盘上）
/public/uploads/

# 开发期截图与临时留痕（可能含会话 Cookie / 测试账号口令，禁止提交）
.wb-shots/
.wb-*.png
shot-*.png
.wb-*.txt
cookie-test.txt
totp.json
totp2.json
body.json
t1.json
t2.json
t3.json
tmp-*.txt
.import-test/

# 开发临时脚本（探针/一次性运维）
scripts/tmp-*

# 内部安全审计报告与审计截图（含站点内部细节，不随开源发布）
docs/shots-*/
docs/security-audit-*.md

# WorkBuddy 会话数据
.workbuddy/

# 系统文件
.DS_Store
Thumbs.db
