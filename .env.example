# 复制为 .env 并填入你的配置。没配置时平台自动使用内置演示数据
DATABASE_URL=mysql://root:你的密码@localhost:3306/inkstack

# 生产环境必填：站点对外地址（sitemap.xml / robots.txt / OAuth 回调用）
# 例：https://inkstack.example.com；不填 sitemap 会落 localhost
NEXT_PUBLIC_SITE_URL=

# 生产环境（nginx/云负载均衡反代后）必须设为 1：限流与审计日志才取真实客户端 IP。
# 不设时限流按 XFF 首段取值，可被伪造头绕过（本地开发保持不设）。
TRUST_PROXY=

# 会话签名密钥（生产环境务必改成随机长字符串）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# AgentScope 智能体服务（推荐）：启动 agent-service 后填入，分身问答将走 Python 智能体
# 不填则用 Node 内置的演示/直连模式
AGENT_SERVICE_URL=

# Gitee OAuth 登录（可选，国产）：gitee.com → 设置 → 安全设置 → 第三方应用授权 → 创建应用。
# 回调地址填 https://你的域名/api/auth/gitee/callback；填入后登录页 Gitee 按钮自动启用。
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=

# GitHub OAuth 登录（可选）：在 GitHub → Settings → Developer settings → OAuth Apps 创建后填入。
# 不填则登录页点击 GitHub 按钮时提示「凭证未配置」；填入后自动启用真实流程。
# 回调地址填 https://你的域名/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# QQ OAuth 登录（可选）：QQ互联 connect.qq.com → 创建应用（个人开发者可认证，免费）。
# 回调地址填 https://你的域名/api/auth/qq/callback；填入后登录页 QQ 按钮自动出现。
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=

# SMTP 邮件发送（可选）：注册邮箱验证码真发通道。生产环境强烈建议配置——
# 未配置时开发环境走 devCode 降级（验证码回显接口，仅本地测试）；
# 生产环境即使漏配也不会回显验证码，但注册/重置/2FA 恢复将无法收信。
# 例（QQ 邮箱）：SMTP_HOST=smtp.qq.com SMTP_PORT=465 SMTP_USER=xxx@qq.com SMTP_PASS=授权码（非登录密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 发件人显示（缺省「墨栈 InkStack <SMTP_USER>」）
SMTP_FROM=

# 微信支付商户凭证（可选）：接入后充值收银台自动从模拟通道切为真实微信支付。
WECHAT_PAY_MCHID=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=

# 本地视觉自检截图工具（scripts/screenshot.mjs）用的测试账号（可选，仅开发环境）。
# 不要写进版本库：只放在本地 .env 里；未配置时截图工具以游客视角运行。
INK_TEST_EMAIL=
INK_TEST_PASSWORD=
INK_WRITER_EMAIL=
INK_WRITER_PASSWORD=

# ———— 渐进双轨切流（Java 后端接管开关）————
# Java 后端地址；JAVA_ROUTES 是逗号分隔的 /api 路径模式，命中的请求由 Next 中间层
# 转发给 Java 应答，其余仍走 Node。段匹配（/api/articles 不会带错命中 /api/articlesXYZ），
# 填 * 表示全量切流；留空即整套回滚到 Node，不需要改代码。
# 模式里的 * 只匹配**恰好一段**，用于同一资源下只有部分子路由迁完的情况，
# 如 /api/articles/*/unlock —— 直接写 /api/articles 会把还留在 Node 的改删/点赞/举报一起带走。
# 哪些前缀现在可以整体切：node scripts/route-inventory.mjs（机器算，别靠记忆）。
# 前提：两栈必须共用同一个 SESSION_SECRET，且同域下发 Cookie（浏览器按 host 投递、忽略端口）。
JAVA_BASE=http://localhost:3101
JAVA_ROUTES=

# 对拍/自检脚本访问的两栈地址（不设则默认 node=http://localhost:3100、java=http://localhost:3101）
PARITY_NODE=
PARITY_JAVA=

# 迁移工具（POST /api/import）的私网黑名单总闸：默认关闭即"禁止抓取内网/环回地址"。
# 设成 1 只给两种场景用——本机调试自己的 RSS、以及跑 scripts/import-check.mjs 第十三道闸门
# （夹具订阅源必然落在 127.0.0.1 上）。两栈读同一个变量名，Java 侧由 gen-java-env.mjs 透传。
IMPORT_ALLOW_PRIVATE=

# 页面取数（Server Component 进程内直调 lib/data.ts）的分流开关，与 JAVA_ROUTES 是两回事：
# JAVA_ROUTES 切的是 HTTP 接口，这里切的是页面直接调用、不经 HTTP 的那条路。
# 逗号分隔函数名（如 listArticles,getArticle），* 表示全部已移植函数，留空表示一律走 Node SQL。
# 走 Java 时若 JAVA_BASE 不可达会抛错让页面 500，绝不静默回落——回落会把"Java 挂了"
# 伪装成"站点正常"（listArticles 原有的 catch 后降级 demo 数据正是这个坑）。
DATA_VIA_JAVA=

# 双轨验证要两个 dev 实例并存（一个取数走 Node、一个走 Java）时，第二个实例须给独立构建目录，
# 否则两者会互相冲掉 .next/routes-manifest.json 导致 500。
#   NEXT_DIST_DIR=.next-java node node_modules/next/dist/bin/next dev -p 3300
NEXT_DIST_DIR=
