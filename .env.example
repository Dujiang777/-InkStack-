# 复制为 .env 并填入你的配置。没配置时平台自动使用内置演示数据
DATABASE_URL=mysql://root:你的密码@localhost:3306/inkstack

# 生产环境必填：站点对外地址（sitemap.xml / robots.txt / OAuth 回调用）
# 例：https://inkstack.example.com；不填 sitemap 会落 localhost
NEXT_PUBLIC_SITE_URL=

# 生产环境（nginx/云负载均衡反代后）必须设为 1：限流与审计日志才取真实客户端 IP。
# 不设时限流按 XFF 首段取值，可被伪造头绕过（本地开发保持不设）。
# 另有一条双轨期才有的连带后果：爆破计数（rate_hits）的键里带 ip，而这个 ip 两栈各自从请求头里解——
# 不设 1 时 Next 会把自己看到的 socket 对端（本机就是 ::1）注入 XFF，而 Tomcat 不注入、Java 落到 "local"，
# 同一个客户端因此落进两个桶，共享计数看着生效其实没共享。nginx 写上 x-real-ip 之后两侧同源。
TRUST_PROXY=

# Next 边缘那道全站 API 滑窗限流的档位（每 IP 每 60 秒多少次）。留空 = 120，就是给真实读者的默认值。
# 为什么要留这个口子：批量闸门一次打上百个请求、全部来自同一个回环 IP，刷爆之后闸门看到的是 429
# 而不是"两栈不一致"，排查方向会被整个带偏（本项目已因此误判过两次红）。抬高档位只改环境变量、
# 不改代码，且**只影响起它的那台实例**——对照实例照旧 120，闸门 17 才能同时验"档位生效"和"默认没被拆"。
# 生产同理：内网/办公网出口共用一个公网 IP 时，120 会误伤，这里调高比去中间件里改常量安全。
EDGE_API_LIMIT=

# 会话签名密钥（生产环境务必改成随机长字符串）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# 外部智能体服务地址（兼容通道）：非空时两栈都会先把 /api/agent/ask 转给这个服务，转不动再降档。
# P6c 起仓库里已删掉对应的 Python 实现（agent-service/），自己没另起服务就留空；
# 想开内置引擎看下面 AGENT_ENGINE，开引擎前这里必须是空串（转发通道优先，会把它压住）。
# 不填且不开引擎 = 演示/直连模式。
AGENT_SERVICE_URL=

# 没有分身服务时的降档判据：有 Key → /api/agent/status 报 live（Node 直连 DeepSeek），
# 没有 → 报 demo。只影响徽标与 /api/agent/ask，/api/ai/write 只认上面那个地址。
# ⚠ 跑 scripts/ai-check.mjs 这类闸门时别把真 Key 放进来：闸门会照它去问真上游、烧真墨水。
DEEPSEEK_API_KEY=

# DeepSeek 接入点，默认官方地址。留这个口子是给闸门用的：scripts/ai-check.mjs 把它指到
# 一个本地 SSE 夹具，才能验"上游坏态一律不扣墨"这条判据——否则每次验证都要真调一次大模型。
# ⚠ 双轨期两栈必须同值（gen-java-env 会派生），一侧指夹具、一侧指官方，流式对拍必红。
DEEPSEEK_BASE_URL=

# ——— Java 侧智能体引擎（P6c 起顶掉原来的 Python agent-service）———
# off = 不启用，分身走演示/直连；spring-ai = 启用 Spring AI 智能体（大模型 + 文章检索工具）。
# 只有 Java 侧有这个引擎：开了它就必须把 /api/ai、/api/agent 整前缀切给 Java，
# 否则同一个接口在两栈行为不同（闸门 15 验的全是 Java 侧的绝对判据，没有对岸）。
AGENT_ENGINE=off
# OpenAI 兼容端点与模型名。默认指向 DeepSeek 的 /v1，复用上面那把 DEEPSEEK_API_KEY；
# 换百炼/自建网关只改这三行，引擎代码不动。
AGENT_MODEL_BASE_URL=
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=

# ——— 建库（Java 侧；scripts/gen-java-env.mjs 会把它派生进 server 的配置）———
# true（默认）= 每次启动把 db/schema.sql 里的 CREATE TABLE / ALTER TABLE 应用到当前数据源，
#   新库开箱即用、加列上线不必手动导 schema。只执行这两类语句，schema.sql 末尾那两条
#   演示 INSERT 不会被顺手带进来（它们归 scripts/seed.mjs）。
# false = 什么都不做，交给 DBA 手工导。应用连接只有 DML 权限时设成这个，
#   否则每次启动都会因为建表被拒刷一屏告警。
# 闸门 16（scripts/schema-check.mjs）两个方向都验：开着时空库起得来且形状与手工应用逐条一致，
# 关着时一张表都不建、接口也确实应不上。
INKSTACK_SCHEMA_AUTO=true

# Gitee OAuth 登录（可选，国产）：gitee.com → 设置 → 安全设置 → 第三方应用授权 → 创建应用。
# 回调地址填 https://你的域名/api/auth/gitee/callback；填入后登录页 Gitee 按钮自动启用。
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=

# GitHub OAuth 登录（可选）：在 GitHub → Settings → Developer settings → OAuth Apps 创建后填入。
# 不填则登录页点击 GitHub 按钮时提示「凭证未配置」；填入后自动启用真实流程。
# 回调地址填 https://你的域名/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# QQ OAuth 登录（可选）：QQ互联 connect.qq.com → 创建应用（个人开发者可认证，免费）。
# 回调地址填 https://你的域名/api/auth/qq/callback；填入后登录页 QQ 按钮自动出现。
QQ_CLIENT_ID=
QQ_CLIENT_SECRET=

# SMTP 邮件发送（可选）：注册邮箱验证码真发通道。生产环境强烈建议配置——
# 未配置时开发环境走 devCode 降级（验证码回显接口，仅本地测试）；
# 生产环境即使漏配也不会回显验证码，但注册/重置/2FA 恢复将无法收信。
# 例（QQ 邮箱）：SMTP_HOST=smtp.qq.com SMTP_PORT=465 SMTP_USER=xxx@qq.com SMTP_PASS=授权码（非登录密码）
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 发件人显示（缺省「墨栈 InkStack <SMTP_USER>」）
SMTP_FROM=

# 微信支付商户凭证（可选）：接入后充值收银台自动从模拟通道切为真实微信支付。
WECHAT_PAY_MCHID=
WECHAT_PAY_APIV3_KEY=
WECHAT_PAY_SERIAL=
WECHAT_PAY_PRIVATE_KEY_PATH=

# 本地视觉自检截图工具（scripts/screenshot.mjs）用的测试账号（可选，仅开发环境）。
# 不要写进版本库：只放在本地 .env 里；未配置时截图工具以游客视角运行。
INK_TEST_EMAIL=
INK_TEST_PASSWORD=
INK_WRITER_EMAIL=
INK_WRITER_PASSWORD=

# ———— 渐进双轨切流（Java 后端接管开关）————
# Java 后端地址；JAVA_ROUTES 是逗号分隔的 /api 路径模式，命中的请求由 Next 中间层
# 转发给 Java 应答，其余仍走 Node。段匹配（/api/articles 不会带错命中 /api/articlesXYZ），
# 填 * 表示全量切流；留空即整套回滚到 Node，不需要改代码。
# 模式里的 * 只匹配**恰好一段**，用于同一资源下只有部分子路由迁完的情况，
# 如 /api/articles/*/unlock —— 直接写 /api/articles 会把还留在 Node 的改删/点赞/举报一起带走。
# 哪些前缀现在可以整体切：node scripts/route-inventory.mjs（机器算，别靠记忆）。
#   当前答案是 JAVA_ROUTES=/api —— 58 个 route.ts 全都有 Java 对岸了，这是"web 只剩渲染层"
#   那一档的配置。真切上去之前要知道两件事：
#   ① 跨栈差分的闸门会当场失去对岸。闸门 1/2/3/3'/17 用 scripts/gate-executor.mjs 探到
#      "这一侧其实也是 Java"就直接判死（不是回归，是这一跑没可比的东西了）；
#      闸门 7/9 里五处「并发：确实两栈各答了一半」降级成 SKIP——并发照打、账务照验，
#      丢的只是"成交由两个进程竞争"这一条出处证据。
#   ② 页面不受影响：rewrite 只挂在 /api/ 上，/ 与 /hot /archive /feed.xml /sitemap.xml 仍由 Next 渲染，
#      闸门 6 的 --keep-render 就是钉这一条的。
# 前提：两栈必须共用同一个 SESSION_SECRET，且同域下发 Cookie（浏览器按 host 投递、忽略端口）。
# ⚠ 这一行是"有没有 Java 后端"的总闸，不只决定 HTTP 切流：非空即**页面取数也只问 Java**
#   （见下面那段）。所以**只跑 Next 就留空**——填着地址却不起 Java，每个页面都是 500（有意不回落）。
#   双轨/切流部署填 JAVA_BASE=http://localhost:3101。
JAVA_BASE=
JAVA_ROUTES=

# 对拍/自检脚本访问的两栈地址（不设则默认 node=http://localhost:3100、java=http://localhost:3101）
PARITY_NODE=
PARITY_JAVA=

# 迁移工具（POST /api/import）的私网黑名单总闸：默认关闭即"禁止抓取内网/环回地址"。
# 设成 1 只给两种场景用——本机调试自己的 RSS、以及跑 scripts/import-check.mjs 第十三道闸门
# （夹具订阅源必然落在 127.0.0.1 上）。两栈读同一个变量名，Java 侧由 gen-java-env.mjs 透传。
IMPORT_ALLOW_PRIVATE=

# 页面取数（Server Component 进程内直调 lib/data.ts）从 P7e′ 起只剩一条路，没有开关：
#   JAVA_BASE 非空 → 页面只问 Java；Java 挂了页面就 500，**不静默回落**。
#     回落会把"后端挂了"伪装成"站点正常"（listArticles 原先那句 catch 后降级 demo 数据正是这个坑）。
#   JAVA_BASE 留空 → 页面渲染 lib/demo-data.ts 的演示数据：界面完整能跑，但读不到你库里的真文章。
# 以前的 DATA_VIA_JAVA（逐函数灰度）与应答头 x-data-source 一起退役——只剩一条路之后，
# "报的是哪条路"不再是个问题，而一个含义会变掉的信号比没有信号更坏。
# 想知道页面读的是不是这份库：node scripts/page-check.mjs（闸门 4，拿库里的文章当尺子）。

# 同时跑两个 dev 实例时（比如闸门 6/7/11 要一台"已切流"的），第二个实例须给独立构建目录，
# 否则两者会互相冲掉 .next/routes-manifest.json 导致 500。
#   NEXT_DIST_DIR=.next-cutover node node_modules/next/dist/bin/next dev -p 3400
NEXT_DIST_DIR=
